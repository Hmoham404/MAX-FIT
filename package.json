{
  "name": "maxfit-smart-gym-360",
  "private": true,
  "version": "1.0.0",
  "description": "MAX FIT — SMART GYM 360 by GM LAC: public website + gym ERP back office",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm run dev -w @maxfit/web",
    "dev:api": "npm run dev -w @maxfit/api",
    "build": "npm run build -w @maxfit/web",
    "typecheck": "npm run typecheck -w @maxfit/api && npm run typecheck -w @maxfit/web",
    "test": "node --test tests/",
    "seed:generate": "node scripts/generate-demo-seed.mjs",
    "db:migrate:local": "npm run db:migrate:local -w @maxfit/api",
    "db:migrate:remote": "npm run db:migrate:remote -w @maxfit/api",
    "deploy:api": "npm run deploy -w @maxfit/api"
  }
}